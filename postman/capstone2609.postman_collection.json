{
  "info": {
    "name": "Capstone2609 - Image Sharing REST API",
    "description": "Express + TypeScript + Prisma/MySQL. Chọn environment Local. Register → Login → chọn file và Upload → các API còn lại → Cleanup. Login tự lưu accessToken, Upload tự lưu imageId. Bảng luu_anh chỉ có API đọc theo phạm vi mới.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"mat_khau\": \"{{password}}\",\n  \"ho_ten\": \"Người dùng demo\",\n  \"tuoi\": 22\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response envelope\", () => { const body = pm.response.json(); pm.expect(body).to.have.all.keys(\"statusCode\", \"message\", \"data\", \"error\"); pm.expect(body.statusCode).to.eql(pm.response.code); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login - save accessToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"mat_khau\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response envelope\", () => { const body = pm.response.json(); pm.expect(body).to.have.all.keys(\"statusCode\", \"message\", \"data\", \"error\"); pm.expect(body.statusCode).to.eql(pm.response.code); });",
                  "if (pm.response.code === 200) { pm.environment.set(\"accessToken\", pm.response.json().data.accessToken); }"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Images",
      "item": [
        {
          "name": "Upload - choose image file first",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/images/upload",
            "description": "Chọn file JPEG/PNG/WebP ở trường image trước khi Send. Không tự gắn Content-Type.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "ten_hinh",
                  "type": "text",
                  "value": "Bình minh bên biển"
                },
                {
                  "key": "mo_ta",
                  "type": "text",
